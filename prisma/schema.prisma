generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  businessName String?
  email        String
  phone        String
  service      String
  budget       String?
  timeline     String?
  plan         String?
  message      String     @db.Text
  status       LeadStatus @default(NEW)

  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
}

model AuditRequest {
  id          String     @id @default(cuid())
  websiteUrl  String
  email       String
  focusAreas  String[]   @default([])
  notes       String?    @db.Text
  status      LeadStatus @default(NEW)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  posts        Post[]
}

model Post {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  excerpt          String
  body             String     @db.Text
  status           PostStatus @default(DRAFT)

  featuredImageUrl String?
  socialImageUrl   String?
  seoTitle         String?
  metaDescription  String?
  canonicalUrl     String?

  category         String?
  tags             String[]  @default([])

  authorId         String
  author           User      @relation(fields: [authorId], references: [id])

  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, publishedAt])
}

// Hosting plan specs. Seeded from lib/data/plans.ts (npm run db:seed).
// Unconfirmed spec values are stored as the literal string "TODO_CONFIRM".
model HostingPlan {
  slug                String   @id
  sortOrder           Int
  name                String
  service             String
  price               Int
  priceIsFrom         Boolean  @default(false)
  billingPeriod       String
  renewalPrice        String
  websitesIncluded    String
  storageGb           String
  bandwidth           String
  ram                 String
  cpu                 String
  databases           String
  emailAccounts       String
  backupFrequency     String
  backupRetentionDays String
  monitoringLevel     String
  supportTier         String
  supportResponseTime String
  migrationIncluded   String
  staging             String
  sshAccess           String
  cdn                 String
  region              String
  bestFor             String
  mostPopular         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([service, sortOrder])
}

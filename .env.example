# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Self-hosted Postgres, run via `docker compose up -d` (see docker-compose.yml).
# These three are read by docker-compose.yml to create the role/database.
POSTGRES_USER="sh360"
POSTGRES_PASSWORD=""
POSTGRES_DB="sh360"
# A single plain Postgres instance has no pooler, so DATABASE_URL (used by the
# app at runtime, lib/db.ts) and DIRECT_URL (used by the Prisma CLI for
# migrate/seed/studio) are the same connection string. If you later put
# PgBouncer or similar in front of it, point DATABASE_URL at the pooler and
# keep DIRECT_URL on the raw connection.
DATABASE_URL="postgresql://sh360:PASSWORD@localhost:5433/sh360"
DIRECT_URL="postgresql://sh360:PASSWORD@localhost:5433/sh360"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to your production URL when deployed; not required in local dev.
# NEXTAUTH_URL="https://speedhost360.com"

# Used only by prisma/seed.ts to create the first admin user — not read at runtime.
ADMIN_SEED_EMAIL="admin@speedhost360.com"
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="Admin"

# Google Analytics 4 — leave blank to keep analytics disabled.
NEXT_PUBLIC_GA4_ID=""

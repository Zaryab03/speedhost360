# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Database (self-managed PostgreSQL) -------------------------------------
# Local: `docker compose up -d` (see docker-compose.yml) creates the role and
# database from these three.
POSTGRES_USER="sh360"
POSTGRES_PASSWORD=""
POSTGRES_DB="sh360"

# DATABASE_URL: used by the app at runtime (lib/db-client.ts).
# DIRECT_URL: used by the Prisma CLI (migrate/seed/studio). Same value for a
# single Postgres instance; if you put PgBouncer in front of the app, point
# DATABASE_URL at PgBouncer and keep DIRECT_URL on the direct connection.
DATABASE_URL="postgresql://sh360:PASSWORD@localhost:5433/sh360"
DIRECT_URL="postgresql://sh360:PASSWORD@localhost:5433/sh360"

# TLS to Postgres: "disable" (local / private network), "require", or
# "verify-full" (optionally with DB_SSL_CA set to the server's CA PEM).
DB_SSL="disable"
# DB_SSL_CA=""

# Pool size per app instance. Keep DB_POOL_MAX x instances below the
# server's max_connections (default 100).
DB_POOL_MAX="10"
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_CONNECT_TIMEOUT_MS="5000"

# --- Auth (admin panel) ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to your production URL when deployed; not required in local dev.
# NEXTAUTH_URL="https://speedhost360.com"

# Used only by prisma/seed.ts to create the first admin user — not read at
# runtime. Leave blank to seed only the hosting plans.
ADMIN_SEED_EMAIL="admin@speedhost360.com"
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="Admin"

# --- Public -----------------------------------------------------------------
# Google Analytics 4 — leave blank to keep analytics disabled.
NEXT_PUBLIC_GA4_ID=""

# Client Portal (ERPNext Helpdesk). Linked from header, footer, contact and
# hosting pages. Defaults to https://clients.speedhost360.com.
NEXT_PUBLIC_HELPDESK_URL="https://clients.speedhost360.com"

# --- Smoke test (scripts/smoke-test.ts) -------------------------------------
# BASE_URL="http://localhost:3000"
# SMOKE_ALLOW_REMOTE_DB="1"   # only for a non-production remote database
